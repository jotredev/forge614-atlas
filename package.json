{
  "name": "forge614-atlas",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Orquestacion de contextualizacion profunda para el ecosistema Forge614",
  "exports": "./src/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/interfaces/cli/main.ts --compile --outfile dist/forge614-atlas",
    "build:target": "node scripts/build-target.mjs",
    "smoke:target": "node scripts/smoke-target.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "verify": "bun run scripts/verify.ts"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "forge614-engram": "github:jotredev/forge614-engram#v1.10.0"
  }
}
